# IANA timezone name (e.g. America/New_York, Europe/London). Day/week
# boundaries in activity grids and analytics follow this timezone, not any
# per-user setting - if left commented out, the server's OS default (often
# UTC on a fresh VPS) is used, which can silently attribute late-evening
# sessions to the "wrong" day for a team elsewhere. Uncomment and set this
# to match where your team actually works.
# TZ=
SECRET_KEY=replace-with-a-long-random-secret
# ADMIN_CODE is auto-generated on first startup if left unset, and written
# back to this file (the generated value is also printed to stderr/journal
# once). Set it explicitly only if you want to override the auto-generated one.
ADMIN_CODE=
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=0
# Number of trusted reverse proxy hops in front of this app (e.g. 1 if
# nginx terminates TLS and proxies directly to this app). Leave at 0 unless
# you have a reverse proxy that overwrites X-Forwarded-For - otherwise a
# client can spoof this header to bypass login rate limiting.
TRUSTED_PROXY_COUNT=0
